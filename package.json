{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "22.x",
    "pnpm": "10.x"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "routes:generate": "tsr generate",
    "build": "vite build",
    "typecheck": "pnpm routes:generate && tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm test && pnpm typecheck && pnpm build",
    "check:all": "pnpm check && pnpm test:e2e"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.40",
    "@tanstack/react-start": "1.168.60",
    "clsx": "2.1.1",
    "lucide-react": "0.576.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@biomejs/biome": "2.2.7",
    "@netlify/vite-plugin-tanstack-start": "1.3.19",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.2.2",
    "@tanstack/router-cli": "1.167.40",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.2.2",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "3.2.4"
  }
}
